{
  "name": "@morrow/core-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Contract client, witness assembly, low-S, envelopes and Bitcoin backends shared by every Morrow client.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./envelope": {
      "types": "./src/crypto/browser-envelope.ts",
      "default": "./src/crypto/browser-envelope.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.2.0",
    "bitcoinjs-lib": "7.0.5",
    "libsodium-wrappers-sumo": "0.8.4",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "0.8.2"
  }
}
